{
  "$description": "dryfit's design tokens: the one place a colour or radius of the menu bar app is set. Edit this, then run `npm run menubar:tokens`, which writes Sources/DryfitMenu/UI/Tokens.swift and the marked block of every mock in `$css.files`. Colours are #rrggbb, optionally ' / <alpha>'; `css` is the variable a mock reads.",
  "$css": {
    "light": ":root",
    "dark": "body:has(#th-d:checked)",
    "files": ["docs/design/dryfit-states.html"]
  },
  "color": {
    "window": { "css": "--win", "light": "#fbfbfc", "dark": "#1e1e21" },
    "sidebar": { "css": "--side", "light": "#eeeef1", "dark": "#26262a" },
    "card": { "css": "--card", "light": "#ffffff", "dark": "#2a2a2e" },
    "cardBorder": { "css": "--card-b", "light": "#000000 / 0.08", "dark": "#ffffff / 0.08" },
    "hairline": { "css": "--hair", "light": "#000000 / 0.08", "dark": "#ffffff / 0.09" },
    "code": { "css": "--code", "light": "#f3f3f5", "dark": "#19191b" },
    "glass": {
      "css": "--glass",
      "light": "#ffffff / 0.82",
      "dark": "#28282c / 0.82",
      "comment": "The panel of the menu bar window, drawn over the system's Liquid Glass so it reads as the mockup's."
    },
    "widgetCard": {
      "css": "--widget-card",
      "light": "#ffffff",
      "dark": "#37373c",
      "comment": "A card on that panel. The window's dark card grey is too close to the dark panel to stand apart,\nso the widget's cards are a step lighter there; in light they stay white."
    },
    "text": { "css": "--text", "light": "#1c1c1e", "dark": "#f4f4f6" },
    "muted": { "css": "--muted", "light": "#5f6068", "dark": "#b0b1b9" },
    "faint": { "css": "--faint", "light": "#8a8b93", "dark": "#8b8c95" },
    "button": { "css": "--btn", "light": "#000000 / 0.06", "dark": "#ffffff / 0.09" },
    "buttonHover": { "css": "--btn-h", "light": "#000000 / 0.10", "dark": "#ffffff / 0.15" },
    "selection": { "css": "--sel", "light": "#0a6cff / 0.14", "dark": "#4c9bff / 0.22" },
    "accent": { "css": "--accent", "light": "#0a6cff", "dark": "#4c9bff" },
    "accentTint": { "css": "--accent-t", "light": "#0a6cff / 0.12", "dark": "#4c9bff / 0.18" },
    "dev": { "css": "--dev", "light": "#d6307f", "dark": "#ff6aa9" },
    "devTint": { "css": "--dev-t", "light": "#d6307f / 0.12", "dark": "#ff6aa9 / 0.16" },
    "release": { "css": "--rel", "light": "#12806f", "dark": "#3fd0b6" },
    "releaseTint": { "css": "--rel-t", "light": "#12806f / 0.12", "dark": "#3fd0b6 / 0.15" },
    "bad": { "css": "--bad", "light": "#c8281e", "dark": "#ff6b61" },
    "badTint": { "css": "--bad-t", "light": "#c8281e / 0.09", "dark": "#ff6b61 / 0.12" },
    "badBorder": { "css": "--bad-b", "light": "#c8281e / 0.28", "dark": "#ff6b61 / 0.35" },
    "warn": { "css": "--warn", "light": "#a85d00", "dark": "#ffb340" },
    "warnTint": { "css": "--warn-t", "light": "#e68c00 / 0.14", "dark": "#ffb340 / 0.15" },
    "warnBorder": { "css": "--warn-b", "light": "#c87800 / 0.35", "dark": "#ffb340 / 0.40" },
    "ok": { "css": "--ok", "light": "#2fb457", "dark": "#2fb457" },
    "okTint": { "css": "--ok-t", "light": "#2fb457 / 0.14", "dark": "#2fb457 / 0.14" },
    "okText": { "css": "--ok-text", "light": "#1f8a40", "dark": "#5ddb85" },
    "purple": { "css": "--purple", "light": "#8250dc", "dark": "#b58cff" },
    "purpleTint": { "css": "--purple-t", "light": "#8250dc / 0.14", "dark": "#8250dc / 0.14" }
  },
  "radius": {
    "buttonRadius": { "css": "--r-button", "value": 7 },
    "cardRadius": { "css": "--r-card", "value": 12 },
    "widgetCardRadius": { "css": "--r-widget-card", "value": 14 }
  }
}
