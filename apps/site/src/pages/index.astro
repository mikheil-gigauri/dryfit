---
// The landing page (ADR 0011). Everything else on the site is Starlight; this page is its own layout so
// the hero can show what dryfit does instead of describing it.
//
// The look is an assembly drawing, after the name: a dry fit puts parts together without glue to check
// they fit, then takes them apart. The hero's drawing is the one interactive moment. Each section behind
// it is drawn on a different drafting surface (a grid, hatching, a blueprint, an exploded view, a title
// block), so the page reads as one set of sheets without any section shouting. Teal is always a release
// and magenta always a dev build, as in the CLI and the menu bar app.
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/martian-mono';
import cli from '../../../../packages/dryfit/package.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/mikheil-gigauri/dryfit';
const download = `${repo}/releases/latest/download/Dryfit.dmg`;
const docs = (path: string) => (path.includes('#') ? `${base}${path}` : `${base}${path}/`);
const canonical = new URL(base, Astro.site).href;
const title = 'dryfit: test your npm library in real apps, without npm link or yalc';
const description =
  'Test an unreleased npm library inside the apps that use it, without npm link or yalc. dryfit publishes every change to a registry on your machine, installs it in the apps you choose, and puts them back exactly as they were.';
const ogImage = new URL(`${base}menu/online.light.png`, Astro.site).href;
const apps = ['shop', 'admin', 'checkout'];
const install = 'npm i -g @dryfit/cli';

const shortfalls = [
  {
    problem: 'A symlink, not an install',
    linked:
      'npm link points the app at your library’s folder. Nothing is installed the way the release will be.',
    dryfit:
      'dryfit publishes a real package to a registry on your machine, and the app installs it with its own package manager.',
  },
  {
    problem: 'Two copies of React or Angular',
    linked:
      'The linked folder resolves its own dependencies, so a framework that must load once loads twice.',
    dryfit: 'The app resolves one copy of each framework, exactly as it will for the release.',
  },
  {
    problem: 'Caches keep the old build',
    linked: 'Angular, Vite and Native Federation keep a prebuilt copy until the version changes.',
    dryfit: 'Every change gets a new version, and dryfit clears those caches after each install.',
  },
  {
    problem: 'Cleaning up is on you',
    linked: 'The link stays until you remember it, and a lockfile that points at it is easy to commit.',
    dryfit:
      'Restore puts package.json and the lockfile back byte for byte, and a git hook keeps dev builds out of commits.',
  },
];

const steps = [
  {
    title: 'Set up',
    command: 'dryfit init && dryfit add',
    text: 'Run it in your library’s folder. dryfit finds the apps around it, starts its background service and works out how the library builds.',
  },
  {
    title: 'Link an app',
    command: 'dryfit link shop',
    text: 'dryfit saves the app’s package.json and lockfile, installs a dev build and adds a git hook that keeps it out of commits.',
  },
  {
    title: 'Save a change',
    command: '1.4.1-dev.20261119143201',
    text: 'With dryfit watch running, each save is built, published under a version that never existed and installed by the app’s package manager. dryfit clears stale caches and tells you when to restart a dev server.',
  },
  {
    title: 'Restore',
    command: 'dryfit restore shop',
    text: 'package.json and the lockfile go back byte for byte, and the app reinstalls from them. Nothing is left behind.',
  },
];

const fits = [
  {
    part: 'Package managers',
    names: ['npm', 'pnpm', 'Yarn 2+', 'Bun'],
    note: 'Each app installs the dev build with the package manager and lockfile it already uses.',
    href: 'guides/package-managers',
  },
  {
    part: 'Library builds',
    names: ['Nx', 'Angular CLI', 'any build script'],
    note: 'dryfit works out how the library builds and which folder it publishes. You can change either.',
    href: 'guides/libraries',
  },
  {
    part: 'Framework caches',
    names: ['Angular', 'Vite', 'Native Federation'],
    note: 'Cleared after every install, so a dev server never keeps serving the previous build.',
    href: 'guides/frameworks',
  },
  {
    part: 'Apps that run together',
    names: ['Module Federation', 'Native Federation'],
    note: 'A shell and its remotes are linked and restored as one group, with a warning when their versions drift apart.',
    href: 'guides/frameworks/#apps-that-run-together',
  },
  {
    part: 'Coding agents',
    names: ['Claude Code', 'any agent'],
    note: 'Every command can answer in JSON, and dryfit agent install teaches Claude Code to link, sync and restore for you.',
    href: 'guides/agents',
  },
  {
    part: 'Systems',
    names: ['macOS', 'Linux', 'Node 22.12+'],
    note: 'The CLI runs on both. The menu bar app needs macOS 26 or later.',
    href: 'guides/getting-started',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg?v=2`} type="image/svg+xml" />
    <script is:inline>
      // Follow the theme chosen in the docs, else the system's.
      try {
        const chosen = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          chosen === 'light' || chosen === 'dark'
            ? chosen
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="band top">
      <div class="art grid" aria-hidden="true"></div>
      <div class="art ruler" aria-hidden="true"></div>
      <header class="bar wrap">
        <a class="mark" href={base} aria-label="dryfit home">
          <!-- The app icon drawn small: a release package, with a dev tag cut into its corner. -->
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <mask id="mark-cut">
              <rect width="32" height="32" fill="#fff"></rect>
              <rect x="16.4" y="18.7" width="13.85" height="8.35" rx="4.175" fill="#000"></rect>
            </mask>
            <g mask="url(#mark-cut)">
              <path class="mark-front" d="M16 5.5 25.75 10.375V21.625L16 26.5 6.25 21.625V10.375Z"></path>
              <path class="mark-top" d="M16 5.5 25.75 10.375 16 15.25 6.25 10.375Z"></path>
              <path class="mark-side" d="M16 15.25 25.75 10.375V21.625L16 26.5Z"></path>
              <path class="mark-tape" d="M11.125 7.94 20.875 12.81V15.625"></path>
            </g>
            <rect class="mark-dev" x="17.7" y="20" width="11.25" height="5.75" rx="2.875"></rect>
          </svg>
          dryfit
        </a>
        <nav aria-label="Site">
          <a href={docs('guides/getting-started')}>Docs</a>
          <a href={docs('reference/cli')}>CLI</a>
          <a href={repo}>GitHub</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero wrap">
          <div class="pitch">
            <p class="kicker">For npm library authors who have outgrown npm link and yalc</p>
            <h1>Try your next release in the apps that will install it.</h1>
            <p class="lede">
              dryfit publishes every change you save to a registry on your machine, installs it in the apps you
              choose, and puts them back exactly as they were.
            </p>
            <div class="command" data-copy={install}>
              <code><span class="prompt" aria-hidden="true">$</span> {install}</code>
              <button type="button" class="copy">Copy</button>
              <span class="copied" role="status"></span>
            </div>
            <p class="next">
              Then run <code>dryfit init</code> in your library’s folder. Works with npm, pnpm, Yarn 2+ and Bun on macOS
              and Linux.
              <a href={docs('guides/getting-started')}>Read the getting started guide</a>
            </p>
          </div>

          <figure class="drawing" data-state="release" aria-labelledby="drawing-log">
            <div class="sheet">
              <div class="part">
                <span class="part-name">@acme/ui</span>
                <code class="part-rev">1.4.0</code>
              </div>
              <svg class="leaders" viewBox="0 0 300 64" preserveAspectRatio="none" aria-hidden="true">
                <path pathLength="1" d="M150 0 V24 M50 64 V24 H250 V64 M150 24 V64"></path>
              </svg>
              <ol class="apps">
                {
                  apps.map((app, index) => (
                    <li style={`--i: ${index}`}>
                      <span class="socket">
                        <code class="insert">1.4.0</code>
                      </span>
                      <span class="app-name">{app}</span>
                    </li>
                  ))
                }
              </ol>
              <div class="dimension" aria-hidden="true">
                <code class="dimension-label">1.4.0</code>
              </div>
            </div>
            <dl class="title-block">
              <div>
                <dt>Part</dt>
                <dd>@acme/ui</dd>
              </div>
              <div>
                <dt>Revision</dt>
                <dd class="block-rev">1.4.0, the release</dd>
              </div>
              <div>
                <dt>Fitted to</dt>
                <dd>shop, admin, checkout</dd>
              </div>
            </dl>
            <div class="controls">
              <button type="button" class="fit">Save a change</button>
              <button type="button" class="restore" disabled>Restore</button>
            </div>
            <figcaption id="drawing-log" aria-live="polite">Three apps on the 1.4.0 release.</figcaption>
          </figure>
        </section>
      </main>
    </div>

    <section class="band shortfalls" aria-labelledby="shortfalls-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="shortfalls-title">Where npm link falls short</h2>
          <p>
            A symlink is the fastest way to see a change, and often it is enough. When the change has to behave
            exactly as the release will, these are the gaps. yalc closes the first two, but reuses one version
            between pushes, so caches can still serve the old build.{' '}
            <a href={docs('guides/comparison')}>Compare all three</a>
          </p>
        </div>
        <div class="rows" role="table" aria-label="npm link compared with dryfit">
          <div class="row row-head" role="row">
            <span role="columnheader">The problem</span>
            <span role="columnheader" class="linked">With npm link</span>
            <span role="columnheader" class="fitted">With dryfit</span>
          </div>
          {
            shortfalls.map((item) => (
              <div class="row" role="row">
                <h3 role="rowheader">{item.problem}</h3>
                <p class="linked" role="cell">
                  {item.linked}
                </p>
                <p class="fitted" role="cell">
                  {item.dryfit}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band blueprint steps" aria-labelledby="steps-title">
      <div class="art grid" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <h2 id="steps-title">From a saved file to every app that uses it</h2>
          <p>Four commands, and only the second one touches your app. The last one takes it back.</p>
        </div>
        <ol class="route">
          {
            steps.map((step, index) => (
              <li>
                <span class="node" aria-hidden="true">
                  {index + 1}
                </span>
                <h3>{step.title}</h3>
                <code class:list={{ dev: index === 2 }}>{step.command}</code>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="band fits" aria-labelledby="fits-title">
      <!--
        An exploded view of the dryfit package: the lid (the dev build) lifted off the box (the app) on
        assembly lines, with hidden edges dashed and a dimension line along the front.
      -->
      <svg class="art exploded" viewBox="60 20 500 590" aria-hidden="true">
        <g class="hidden-edges">
          <path d="M300 330 L490.5 440 M300 330 L109.5 440 M300 330 L300 180"></path>
        </g>
        <g class="body-edges">
          <path d="M490.5 440 L300 550 L109.5 440"></path>
          <path d="M490.5 440 V290 M300 550 V400 M109.5 440 V290"></path>
          <path d="M300 180 L490.5 290 L300 400 L109.5 290 Z"></path>
        </g>
        <g class="lid-edges">
          <path d="M300 36 L490.5 146 L300 256 L109.5 146 Z"></path>
          <path d="M490.5 180 L300 290 L109.5 180"></path>
          <path d="M490.5 180 V146 M300 290 V256 M109.5 180 V146"></path>
          <path class="tape" d="M216.9 84 L407.4 194 M192.6 98 L383.1 208"></path>
        </g>
        <g class="assembly">
          <path d="M490.5 190 V276 M300 300 V386 M109.5 190 V276"></path>
          <path class="tip" d="M486 268 L490.5 280 L495 268 Z M295.5 378 L300 390 L304.5 378 Z M105 268 L109.5 280 L114 268 Z"></path>
        </g>
        <g class="dims">
          <path d="M521.7 458 L331.2 568 M495.7 443 L530.4 463 M305.2 553 L339.8 573"></path>
          <path d="M78.3 458 V308 M104.3 443 L69.6 463 M104.3 293 L69.6 313"></path>
          <text x="426.4" y="513" transform="rotate(-30 426.4 513)" dy="-8">1.4.1-dev</text>
          <text x="78.3" y="383" transform="rotate(-90 78.3 383)" dy="-8">1.4.0</text>
        </g>
      </svg>
      <div class="wrap">
        <div class="section-head">
          <h2 id="fits-title">It fits the setup you already have</h2>
          <p>
            No new package manager, no config file in your apps and nothing to remember to undo. dryfit adapts to how
            each app already installs and builds.
          </p>
        </div>
        <div class="parts" role="table" aria-label="What dryfit works with">
          <div class="parts-row parts-head" role="row">
            <span role="columnheader">Part</span>
            <span role="columnheader">Fits</span>
            <span role="columnheader">What dryfit does</span>
          </div>
          {
            fits.map((item) => (
              <div class="parts-row" role="row">
                <h3 role="rowheader">{item.part}</h3>
                <ul class="names" role="cell">
                  {item.names.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
                <p role="cell">
                  {item.note} <a href={docs(item.href)} aria-label={`More about ${item.part.toLowerCase()}`}>More</a>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band desk-band menu" aria-labelledby="menu-title">
      <div class="art dots" aria-hidden="true"></div>
      <div class="wrap menu-layout">
        <div class="menu-text">
          <h2 id="menu-title">Keep an eye on it from the menu bar</h2>
          <p>
            On macOS, dryfit’s menu shows every library, the apps it is linked into and the version each one runs.
            Turn on auto-sync, link another app, restore one or read why an install failed, all without a terminal.
          </p>
          <a class="button" href={download}>Download for macOS</a>
          <p class="note">
            Needs macOS 26 or later. The app is not notarized yet, so macOS asks you to allow it the first time.{' '}
            <a href={docs('guides/menu-bar')}>How to open it</a>
          </p>
        </div>
        <!-- Both images are captured from the running app (scripts/generate.ts copies them). -->
        <figure
          class="desk"
          role="img"
          aria-label="The dryfit window showing @acme/ui linked into shop and admin, with the menu bar menu open in front of it listing the same library, its apps and a group."
        >
          <div class="window">
            <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img class="only-light" src={`${base}menu/window-library.light.png`} width="1000" height="690" alt="" />
            <img class="only-dark" src={`${base}menu/window-library.dark.png`} width="1000" height="690" alt="" />
          </div>
          <div class="popover">
            <img class="only-light" src={`${base}menu/online.light.png`} width="372" height="513" alt="" />
            <img class="only-dark" src={`${base}menu/online.dark.png`} width="372" height="513" alt="" />
          </div>
        </figure>
      </div>
    </section>

    <section class="band closing" aria-labelledby="closing-title">
      <div class="art grid" aria-hidden="true"></div>
      <div class="wrap closing-layout">
        <span class="register r1" aria-hidden="true"></span>
        <span class="register r2" aria-hidden="true"></span>
        <h2 id="closing-title">Try it on the change you are making today.</h2>
        <p>
          Install the CLI, run <code>dryfit init</code> in your library’s folder and link one app. When you are done,{' '}
          <code>dryfit restore</code> leaves the app exactly as you found it.
        </p>
        <div class="closing-actions">
          <div class="command" data-copy={install}>
            <code><span class="prompt" aria-hidden="true">$</span> {install}</code>
            <button type="button" class="copy">Copy</button>
            <span class="copied" role="status"></span>
          </div>
          <a class="button ghost" href={docs('guides/getting-started')}>Read the guide</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <dl class="sheet-block">
          <div class="sb-project">
            <dt>Project</dt>
            <dd>dryfit</dd>
          </div>
          <div>
            <dt>Current version</dt>
            <dd><a href={`${repo}/releases`}>{cli.version}</a></dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>MIT, open source</dd>
          </div>
          <div>
            <dt>Docs</dt>
            <dd>
              <a href={docs('guides/getting-started')}>Guides</a>, <a href={docs('reference/cli')}>CLI reference</a>
            </dd>
          </div>
          <div>
            <dt>Why it works this way</dt>
            <dd><a href={`${repo}/tree/main/docs/adr`}>Design decisions</a></dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd><a href={repo}>GitHub</a></dd>
          </div>
        </dl>
      </div>
    </footer>

    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

      for (const block of document.querySelectorAll<HTMLElement>('.command')) {
        const button = block.querySelector('button');
        const status = block.querySelector('.copied');
        button?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(block.dataset.copy ?? '');
            button.textContent = 'Copied';
            if (status) status.textContent = 'Copied to the clipboard';
          } catch {
            button.textContent = 'Select and copy';
          }
          setTimeout(() => {
            button.textContent = 'Copy';
            if (status) status.textContent = '';
          }, 2000);
        });
      }

      const drawing = document.querySelector<HTMLElement>('.drawing');
      if (drawing) {
        const inserts = [...drawing.querySelectorAll<HTMLElement>('.insert')];
        const partRev = drawing.querySelector<HTMLElement>('.part-rev');
        const dimension = drawing.querySelector<HTMLElement>('.dimension-label');
        const blockRev = drawing.querySelector<HTMLElement>('.block-rev');
        const log = drawing.querySelector<HTMLElement>('figcaption');
        const fit = drawing.querySelector<HTMLButtonElement>('.fit');
        const restore = drawing.querySelector<HTMLButtonElement>('.restore');
        const STEP_MS = 280;
        let lastStamp = 0;
        let timers: number[] = [];

        // The same scheme as the real thing: patch bump, then dev and a UTC timestamp (ADR 0004).
        const devStamp = () => {
          const now = new Date();
          const pad = (n: number) => String(n).padStart(2, '0');
          let stamp = Number(
            `${now.getUTCFullYear()}${pad(now.getUTCMonth() + 1)}${pad(now.getUTCDate())}` +
              `${pad(now.getUTCHours())}${pad(now.getUTCMinutes())}${pad(now.getUTCSeconds())}`,
          );
          if (stamp <= lastStamp) stamp = lastStamp + 1;
          lastStamp = stamp;
          return stamp;
        };

        const show = (state: 'dev' | 'release', version: string, short: string, revision: string, message: string) => {
          timers.forEach(clearTimeout);
          timers = [];
          drawing.dataset.state = state;
          if (partRev) partRev.textContent = short;
          if (dimension) dimension.textContent = version;
          if (blockRev) blockRev.textContent = revision;
          const delay = reduceMotion.matches ? 0 : STEP_MS;
          inserts.forEach((element, index) => {
            const apply = () => {
              element.textContent = short;
              element.classList.remove('seated');
              void element.offsetWidth;
              element.classList.add('seated');
            };
            if (delay === 0) apply();
            else timers.push(window.setTimeout(apply, delay * (index + 1)));
          });
          timers.push(
            window.setTimeout(
              () => {
                if (log) log.textContent = message;
              },
              delay * (inserts.length + 1),
            ),
          );
        };

        fit?.addEventListener('click', () => {
          const version = `1.4.1-dev.${devStamp()}`;
          show('dev', version, '1.4.1-dev', version, `Built ${version} and installed it in shop, admin and checkout.`);
          if (restore) restore.disabled = false;
        });
        restore?.addEventListener('click', () => {
          show('release', '1.4.0', '1.4.0', '1.4.0, the release', 'Restored. Every app is back on 1.4.0, lockfile and all.');
          restore.disabled = true;
          fit?.focus();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /*
   * Tokens. Light is drafting film: cool paper, graphite ink. Dark is a blueprint. Both keep the product's
   * two semantic colors: --release (teal) and --dev (magenta).
   */
  :root {
    --paper: #f4f7f9;
    --sheet: #fbfcfd;
    --ink: #17202b;
    --pencil: #5c6977;
    --grid: #d5dee5;
    --release: #0f7b6c;
    --dev: #c2257a;
    --on-ink: #f4f7f9;
    --sans: 'Bricolage Grotesque Variable', system-ui, sans-serif;
    --mono: 'Martian Mono Variable', ui-monospace, monospace;
    --measure: 34rem;
    --gutter: clamp(1rem, 4vw, 3rem);
    --max: 78rem;
    --cell: 24px;
    --ease: cubic-bezier(0.3, 0.7, 0.2, 1);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #0c1d2c;
      --sheet: #10263a;
      --ink: #e3edf4;
      --pencil: #93a8ba;
      --grid: #21405a;
      --release: #3cc9b0;
      --dev: #ff6fb2;
      --on-ink: #0c1d2c;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --paper: #0c1d2c;
    --sheet: #10263a;
    --ink: #e3edf4;
    --pencil: #93a8ba;
    --grid: #21405a;
    --release: #3cc9b0;
    --dev: #ff6fb2;
    --on-ink: #0c1d2c;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 400 1.0625rem/1.6 var(--sans);
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  a {
    color: inherit;
    text-decoration-color: var(--release);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--release);
  }
  :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 2px;
  }
  code {
    font-family: var(--mono);
    font-size: 0.8125em;
  }
  h1,
  h2,
  h3 {
    margin: 0;
    text-wrap: balance;
  }
  /* Display type is condensed, like lettering on a drawing; body text stays at full width. */
  h1,
  h2 {
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: -0.01em;
    line-height: 0.98;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  h3 {
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.25;
  }
  p {
    text-wrap: pretty;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 0.5rem;
    z-index: 10;
    background: var(--sheet);
    padding: 0.5rem 0.75rem;
  }
  .only-dark {
    display: none;
  }
  :root[data-theme='dark'] .only-dark {
    display: block;
  }
  :root[data-theme='dark'] .only-light {
    display: none;
  }

  /*
   * Bands run the full width and carry the drawing surface; .wrap holds the content to the page's measure.
   * Art sits behind the content in each band and never takes pointer events.
   */
  .band {
    position: relative;
    isolation: isolate;
  }
  .wrap {
    width: min(100%, var(--max));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .art {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  /* Drafting grid: a fine 24px grid with a heavier line every fifth cell, centered on the page. */
  .grid {
    inset: 0;
    --minor: color-mix(in srgb, var(--grid) 55%, transparent);
    --major: var(--grid);
    background-image:
      linear-gradient(var(--major) 1px, transparent 1px),
      linear-gradient(90deg, var(--major) 1px, transparent 1px),
      linear-gradient(var(--minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--minor) 1px, transparent 1px);
    background-size:
      calc(var(--cell) * 5) calc(var(--cell) * 5),
      calc(var(--cell) * 5) calc(var(--cell) * 5),
      var(--cell) var(--cell),
      var(--cell) var(--cell);
    background-position: calc(50% + 0.5px) -1px;
  }

  /* Header and hero share one sheet: the grid starts under the ruler and fades out behind the pitch. */
  .top .grid {
    -webkit-mask-image: radial-gradient(ellipse 62% 78% at 74% 42%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 62% 78% at 74% 42%, #000 20%, transparent 78%);
  }
  @media (max-width: 64rem) {
    .top .grid {
      -webkit-mask-image: radial-gradient(ellipse 90% 45% at 50% 72%, #000 25%, transparent 80%);
      mask-image: radial-gradient(ellipse 90% 45% at 50% 72%, #000 25%, transparent 80%);
    }
  }
  /* A scale along the top edge of the page, its ticks on the grid's lines. */
  .ruler {
    inset: 0 0 auto;
    height: 14px;
    --tick: color-mix(in srgb, var(--pencil) 55%, transparent);
    background-image:
      linear-gradient(90deg, var(--tick) 1px, transparent 1px),
      linear-gradient(90deg, var(--tick) 1px, transparent 1px);
    background-size:
      calc(var(--cell) * 5) 14px,
      var(--cell) 6px;
    background-repeat: repeat-x;
    background-position: calc(50% + 0.5px) 0;
    border-top: 3px solid var(--ink);
  }

  /* Header */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem 1.25rem;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-stretch: 80%;
    font-size: 1.5rem;
    text-decoration: none;
  }
  .mark svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .mark-front {
    fill: var(--release);
  }
  .mark-top {
    fill: color-mix(in srgb, var(--release) 45%, #fff);
  }
  .mark-side {
    fill: color-mix(in srgb, var(--release) 82%, #000);
  }
  .mark-tape {
    fill: none;
    stroke: color-mix(in srgb, var(--release) 12%, #fff);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }
  .mark-dev {
    fill: var(--dev);
  }
  .bar nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .bar nav a {
    text-decoration: none;
    font-weight: 500;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: clamp(2rem, 7vw, 5rem) clamp(4rem, 9vw, 7rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .kicker {
    margin: 0 0 1.25rem;
    color: var(--pencil);
    font-size: 0.9375rem;
    font-weight: 600;
    max-width: 40ch;
  }
  h1 {
    font-size: clamp(3rem, 6.4vw, 5.5rem);
    line-height: 0.92;
    max-width: 11ch;
  }
  .lede {
    max-width: var(--measure);
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 1.75rem 0 2rem;
  }
  .next {
    color: var(--pencil);
    max-width: var(--measure);
    font-size: 0.9375rem;
    margin: 1.25rem 0 0;
  }
  .next code {
    color: var(--ink);
  }
  .next a {
    display: block;
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--ink);
    font-weight: 600;
  }

  .command {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    padding: 0.75rem 0.75rem 0.75rem 1.125rem;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: 6px;
  }
  .command code {
    min-width: 0;
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .prompt {
    color: color-mix(in srgb, var(--release) 70%, var(--on-ink));
    margin-right: 0.25rem;
  }
  .copy {
    flex: none;
    min-height: 2.25rem;
    font: 600 0.8125rem var(--sans);
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--on-ink) 40%, transparent);
    border-radius: 4px;
    padding: 0.375rem 0.75rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--on-ink);
  }
  .command .copy:focus-visible {
    outline-color: var(--on-ink);
  }
  .copied {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /*
   * The drawing. Released, the part floats above the apps on dashed construction lines: an exploded view.
   * Dry-fitted, it drops into place, the leaders turn solid magenta and each app's insert is replaced in turn.
   */
  .drawing {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .sheet {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2rem);
    background: var(--sheet);
    border: 1px solid var(--grid);
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--paper) 70%, transparent),
      0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--ink) 30%, transparent);
  }
  /* Crop marks at the sheet's corners. */
  .sheet::before,
  .sheet::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--pencil);
  }
  .sheet::before {
    top: -12px;
    left: -12px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .sheet::after {
    bottom: -12px;
    right: -12px;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
  .part {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-inline: auto;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.75rem 1.125rem;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 4px;
    transform: translateY(-0.75rem);
    transition: transform 450ms var(--ease);
  }
  .drawing[data-state='dev'] .part {
    transform: translateY(0.5rem);
  }
  .part-name {
    font-weight: 700;
    font-stretch: 85%;
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    line-height: 1;
  }
  .part-rev {
    font-size: 0.75rem;
    color: var(--release);
    transition: color 200ms;
  }
  .drawing[data-state='dev'] .part-rev {
    color: var(--dev);
  }
  .leaders {
    display: block;
    width: 100%;
    height: clamp(3rem, 7vw, 4.5rem);
    overflow: visible;
  }
  .leaders path {
    fill: none;
    stroke: var(--pencil);
    stroke-width: 1.5;
    stroke-dasharray: 0.02 0.015;
    vector-effect: non-scaling-stroke;
    transition: stroke 300ms;
  }
  .drawing[data-state='dev'] .leaders path {
    stroke: var(--dev);
    stroke-width: 2;
    stroke-dasharray: none;
  }
  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 2vw, 1.25rem);
  }
  .apps li {
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    padding: 0.875rem 0.5rem 0.75rem;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    border-radius: 4px;
  }
  .socket {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 8.5rem;
    min-height: 2.25rem;
    border: 1.5px dashed var(--grid);
    border-radius: 3px;
  }
  .insert {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    color: var(--release);
    border: 1.5px solid currentColor;
    border-radius: 3px;
    background: var(--sheet);
    white-space: nowrap;
  }
  .drawing[data-state='dev'] .insert {
    color: var(--dev);
    transition: color 0s calc((var(--i) + 1) * 280ms);
  }
  .insert.seated {
    animation: seat 420ms var(--ease);
  }
  .app-name {
    font-weight: 600;
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
  }
  /* A dimension line under the apps: the version every one of them runs. */
  .dimension {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    padding-inline: 0.75rem;
    color: var(--release);
    transition: color 200ms;
  }
  .drawing[data-state='dev'] .dimension {
    color: var(--dev);
  }
  .dimension::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1.5px solid currentColor;
  }
  .dimension::after {
    content: '';
    position: absolute;
    inset: calc(50% - 6px) 0 auto;
    height: 12px;
    border-inline: 1.5px solid currentColor;
  }
  .dimension-label {
    position: relative;
    z-index: 1;
    padding: 0 0.625rem;
    background: var(--sheet);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .title-block {
    display: grid;
    grid-template-columns: repeat(3, auto);
    margin: 0;
    background: var(--sheet);
    border: 1px solid var(--grid);
    font-size: 0.875rem;
  }
  .title-block > div {
    padding: 0.5rem 0.75rem;
    min-width: 0;
  }
  .title-block > div + div {
    border-left: 1px solid var(--grid);
  }
  .title-block dt {
    color: var(--pencil);
    font-size: 0.8125rem;
  }
  .title-block dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .drawing[data-state='dev'] .block-rev {
    color: var(--dev);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.75rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .controls button,
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font: 600 0.9375rem var(--sans);
    padding: 0.625rem 1.125rem;
    border-radius: 6px;
    border: 1.5px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
  }
  .fit,
  .button {
    background: var(--ink);
    color: var(--on-ink);
  }
  .fit:hover,
  .button:hover {
    color: var(--on-ink);
    background: color-mix(in srgb, var(--ink) 85%, var(--paper));
  }
  .restore,
  .button.ghost {
    background: var(--paper);
    color: var(--ink);
  }
  .button.ghost:hover {
    color: var(--ink);
    background: var(--sheet);
  }
  .restore:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .drawing figcaption {
    min-height: 3.2em;
    color: var(--pencil);
    font-size: 0.9375rem;
  }
  @keyframes seat {
    from {
      transform: translateY(-0.75rem);
      opacity: 0;
    }
  }
  /* The one moment on load: the construction lines are drawn. */
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
      stroke-dasharray: 1 1;
    }
    to {
      stroke-dashoffset: 0;
      stroke-dasharray: 1 1;
    }
  }
  .leaders path {
    animation: draw 900ms var(--ease) 200ms backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .leaders path,
    .insert.seated {
      animation: none;
    }
    .part,
    .part-rev,
    .leaders path,
    .dimension,
    .drawing[data-state='dev'] .insert {
      transition: none;
    }
  }
  @media (max-width: 30rem) {
    .title-block {
      grid-template-columns: 1fr;
    }
    .title-block > div + div {
      border-left: 0;
      border-top: 1px solid var(--grid);
    }
    .insert {
      font-size: 0.6875rem;
      padding-inline: 0.375rem;
    }
  }

  /* Sections after the hero */
  .shortfalls,
  .steps,
  .fits,
  .menu,
  .closing {
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  .section-head {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: end;
  }
  @media (min-width: 56rem) {
    .section-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure));
    }
  }
  .section-head h2 {
    max-width: 16ch;
  }
  .steps .section-head h2 {
    max-width: 18ch;
  }
  .section-head p {
    margin: 0;
    color: var(--pencil);
  }
  .section-head p a {
    color: var(--ink);
    font-weight: 600;
  }

  /*
   * Where npm link falls short. The npm link column is hatched, as a drawing hatches material that is cut
   * away; the dryfit column is tinted teal. The bands run unbroken from the header row to the last row.
   */
  .shortfalls {
    border-top: 1px solid var(--grid);
  }
  .rows {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--grid);
  }
  .row p {
    margin: 0;
    max-width: 38ch;
  }
  .row-head {
    display: none;
    color: var(--pencil);
    font-size: 0.875rem;
    font-weight: 600;
    padding-block: 0.75rem;
    border-top: 0;
  }
  .row-head .fitted {
    color: var(--release);
  }
  .linked {
    color: var(--pencil);
  }
  .fitted {
    padding-left: 0.875rem;
    border-left: 3px solid var(--release);
  }
  @media (min-width: 56rem) {
    .row {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
    .row-head {
      display: grid;
    }
    .linked,
    .fitted {
      position: relative;
    }
    .linked::before,
    .fitted::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -1.25rem -1.25rem calc(-1.25rem - 1px);
    }
    .row-head .linked::before,
    .row-head .fitted::before {
      inset-block: -0.75rem -0.75rem;
    }
    .linked::before {
      background: repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--grid) 70%, transparent) 0 1px,
        transparent 1px 9px
      );
    }
    .fitted {
      border-left: 0;
      padding-left: 0;
    }
    .fitted::before {
      background: color-mix(in srgb, var(--release) 7%, transparent);
      border-left: 3px solid var(--release);
    }
  }

  /*
   * Steps, on a blueprint: the band takes the dark palette in both themes. The steps are a real sequence,
   * so they are numbered, and a route with an arrowhead runs through their markers.
   */
  .blueprint {
    --paper: #10304d;
    --sheet: #143a5c;
    --ink: #eef5fa;
    --pencil: #a9c0d3;
    --grid: #2a5175;
    --release: #3cc9b0;
    --dev: #ff6fb2;
    --on-ink: #10304d;
    background: var(--paper);
    color: var(--ink);
    color-scheme: dark;
  }
  :root[data-theme='dark'] .blueprint {
    --paper: #071624;
    --sheet: #0c2133;
    --grid: #183754;
    --on-ink: #071624;
  }
  .blueprint .grid {
    -webkit-mask-image: linear-gradient(#000 40%, transparent);
    mask-image: linear-gradient(#000 40%, transparent);
  }
  .blueprint :focus-visible {
    outline-color: var(--ink);
  }
  .route {
    --node: 2.75rem;
    position: relative;
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
  }
  /* The route: down the left on small screens, across the top on wide ones. */
  .route::before {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2);
    bottom: 0;
    left: calc(var(--node) / 2 - 1px);
    border-left: 2px dashed var(--pencil);
  }
  .route::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: calc(var(--node) / 2 - 6px);
    border: 6px solid transparent;
    border-top: 10px solid var(--pencil);
    border-bottom: 0;
  }
  .route li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding-left: calc(var(--node) + 1.25rem);
  }
  .node {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .route li:nth-child(3) .node {
    border-color: var(--dev);
    color: var(--dev);
  }
  .route li:last-child .node {
    border-color: var(--release);
    color: var(--release);
  }
  .route h3 {
    min-height: var(--node);
    display: flex;
    align-items: center;
  }
  .route code {
    justify-self: start;
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    padding: 0.3125rem 0.625rem;
    border-radius: 4px;
    background: var(--sheet);
    border: 1px solid var(--grid);
  }
  .route code.dev {
    color: var(--dev);
    border-color: color-mix(in srgb, var(--dev) 45%, var(--grid));
  }
  .route p {
    margin: 0;
    color: var(--pencil);
  }
  @media (min-width: 72rem) {
    .route {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .route::before {
      left: calc(var(--node) / 2);
      right: 0;
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed var(--pencil);
      top: calc(var(--node) / 2 - 1px);
    }
    .route::after {
      left: auto;
      right: -2px;
      bottom: auto;
      top: calc(var(--node) / 2 - 6px);
      border: 6px solid transparent;
      border-left: 10px solid var(--pencil);
      border-right: 0;
    }
    .route li {
      padding-left: 0;
      padding-top: calc(var(--node) + 1.25rem);
    }
    .route h3 {
      min-height: 0;
    }
  }

  /* What it fits: a parts list, with the exploded package drawn behind the section's heading. */
  .fits {
    overflow: hidden;
  }
  .exploded {
    top: clamp(1rem, 4vw, 3rem);
    right: max(-6rem, calc((100vw - var(--max)) / 2 - 4rem));
    width: clamp(18rem, 34vw, 30rem);
    height: auto;
    opacity: 0.9;
  }
  .exploded path {
    fill: none;
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .exploded .hidden-edges path {
    stroke: var(--grid);
    stroke-dasharray: 6 5;
  }
  .exploded .body-edges path {
    stroke: color-mix(in srgb, var(--pencil) 55%, transparent);
  }
  .exploded .lid-edges path {
    stroke: color-mix(in srgb, var(--dev) 60%, transparent);
  }
