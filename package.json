{
  "name": "dryfit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/site"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present",
    "menubar:test": "cd apps/menubar && xcrun swift test",
    "menubar:tokens": "node apps/menubar/scripts/tokens.mjs",
    "menubar:e2e": "npm run build -w @dryfit/cli && apps/menubar/scripts/e2e.sh",
    "menubar:bundle": "apps/menubar/scripts/bundle.sh",
    "menubar:dmg": "apps/menubar/scripts/bundle.sh && apps/menubar/scripts/dmg.sh",
    "release": "changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3"
  }
}
